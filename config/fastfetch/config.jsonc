{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "type": "kitty",
        "source": "/home/wonder/Pictures/capuccin_fastfetch.jpg",
        "width": 45,
        "height": 21,
        "padding": {
            "right": 3
        }
    },

    "display": {
        "separator": "  ",
        "color": {
            "keys": "#89b4fa",
            "title": "#cdd6f4"
        },
        "key": {
            "width": 13
        },
        "percent": {
            "type": 9
        }
    },

    "modules": [
        { "type": "custom", "format": "{#bold_blue}╭─────────────── SYSTEM ───────────────╮" },
        { "type": "title", "format": "{#1;38;2;137;180;250} Wonder {#default}{#bright_black}· {host-name}" },
        { "type": "os",       "key": " OS",       "format": "{name} {arch}" },
        { "type": "kernel",   "key": " Kernel" },
        { "type": "uptime",   "key": " Uptime" },
        { "type": "packages", "key": " Packages" },
        { "type": "shell",    "key": " Shell",    "format": "{pretty-name} {version}" },

        { "type": "custom", "format": "{#bold_blue}├────────────── HARDWARE ──────────────┤" },
        { "type": "cpu",      "key": " CPU",      "format": "{name} ({cores-physical}C/{cores-logical}T)" },
        { "type": "gpu",      "key": " GPU" },
        { "type": "de",       "key": " WM" },
        { "type": "terminal", "key": "󰄛 Terminal" },

        { "type": "custom", "format": "{#bold_blue}├─────────────── STORAGE ──────────────┤" },
        { "type": "memory",   "key": " RAM" },
        { "type": "swap",     "key": " Swap" },
        { "type": "disk",     "key": " Disk /",  "folders": "/" },
        { "type": "disk",     "key": " Games",   "folders": "/mnt/hdd" },

        { "type": "custom", "format": "{#bold_blue}├────────────── NETWORK ───────────────┤" },
        { "type": "localip",  "key": " IP",      "format": "{ipv4} ({ifname})" },
        { "type": "locale",   "key": " Locale" },


        { "type": "custom", "format": "{#bold_blue}╰──────────────────────────────────────╯" }
    ]
}
