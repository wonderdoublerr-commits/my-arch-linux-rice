#!/usr/bin/env python3
"""rice-theme v2 <photo|cappuccino>
Хот-релоад палитры: бар (quickshell сам перечитывает конфиг),
dunst, бордеры окон, тема walker, swayosd. Ничего не убивает."""
import sys, os, subprocess, re, fcntl, time, json, hashlib

HOME = os.path.expanduser("~")
MARKER = HOME + "/.config/rice/.current"

CAP = ["#11111b", "#1e1e2e", "#36364a", "#89b4fa", "#cdd6f4", "#a6adc8",
       "#f38ba8", "#45475a", "#6b454f", "#3a252b"]
PHO = ["#0f150b", "#162113", "#31452a", "#8fc07a", "#edeaf3", "#acafa8",
       "#d98f8f", "#22301d", "#4a5a3f", "#25301f"]

BORDERS = [("7f8ff5ff", "8fc07aff"),
           ("a5b4fcff", "a9d19aff"),
           ("2d3042aa", "31452aaa")]

WALKER = [("#161821", "#101609"), ("#7f8ff5", "#8fc07a"),
          ("#a5b4fc", "#a9d19a"), ("#f2f4ff", "#edeaf3"),
          ("#181a24", "#141c0f"), ("#1e2030", "#1a2414"),
          ("#2d3042", "#31452a"), ("#9299b5", "#acafa8"),
          ("#60a5fa", "#79a85e"), ("#8b5cf6", "#5d8a46")]

SWAYOSD = [("#36364a", "#31452a"), ("#89b4fa", "#8fc07a"),
           ("#cdd6f4", "#edeaf3"), ("30, 30, 46", "22, 33, 19"),
           ("166, 173, 200", "172, 175, 168")]

def sub(path, pairs):
    s = open(path, encoding="utf-8").read()
    for a, b in pairs:
        s = s.replace(a.lower(), b.lower())
    open(path, "w", encoding="utf-8").write(s)

def sh(cmd):
    subprocess.run(cmd, shell=True)

# ── Анимация смены обоев ────────────────────────────────────
# Круглую «линзу» с свечением рисует сам quickshell (см. shell.qml).
# Сюда же готовится «зерно» — кадр со свежим кружком новых обоев
# в центре, чтобы внутри ободка обои были уже во время зависания.
# Если бар не запущен — фолбэк на штатный grow-переход awww.

LENS_R = 90  # радиус линзы в логических пикселях (синхрон с shell.qml)

SEED_DIR = HOME + "/.cache/rice/seeds"

def make_seed(old, new):
    """Кадр: старые обои + мягкий круг новых обоев в центре экрана.
    Кэшируется по паре (старые, новые) — повторные переключения
    берут сид из кэша мгновенно, обои в круге с первого кадра."""
    try:
        mon = json.loads(subprocess.check_output(
            ["hyprctl", "monitors", "-j"], text=True))[0]
        W, H = int(mon["width"]), int(mon["height"])
        scale = float(mon.get("scale") or 1)
    except Exception:
        return None
    r = int(LENS_R * scale)
    cx, cy = W // 2, H // 2
    fit = ["-filter", "Triangle", "-resize", f"{W}x{H}^",
           "-gravity", "center", "-extent", f"{W}x{H}"]
    os.makedirs(SEED_DIR, exist_ok=True)
    key = hashlib.md5(f"{old}|{new}|{W}x{H}:{r}".encode()).hexdigest()
    seed = f"{SEED_DIR}/{key}.jpg"
    if os.path.exists(seed):
        return seed                     # попадание в кэш — мгновенно
    mask = f"/tmp/rice_mask_{W}x{H}.png"
    if not os.path.exists(mask):
        try:
            subprocess.run(["magick", "-size", f"{W}x{H}", "xc:none",
                            "-fill", "white",
                            "-draw", f"circle {cx},{cy} {cx},{cy - r}",
                            "-blur", "0x6", "-level", "30%,70%", mask],
                           check=True, capture_output=True, timeout=10)
        except Exception:
            return None
    # ВАЖНО: три отдельных вызова. Однострочник со скобками в IM7
    # ломает финальный over-composite (дыра остаётся прозрачной и
    # JPEG заливает её белым). BMP-промежуточные — быстрая запись.
    cut = f"/tmp/rice_cut_{os.getpid()}.bmp"
    try:
        subprocess.run(["magick", new, *fit, mask,
                        "-compose", "CopyOpacity", "-composite", cut],
                       check=True, capture_output=True, timeout=10)
        subprocess.run(["magick", old, *fit, cut,
                        "-gravity", "center", "-compose", "over",
                        "-composite", "-strip", "-quality", "88",
                        "-define", "jpeg:dct-method=fast", seed],
                       check=True, capture_output=True, timeout=10)
        try:
            os.remove(cut)
        except OSError:
            pass
        return seed if os.path.exists(seed) else None
    except Exception:
        return None

def show_wallpaper(wp, old=""):
    qs = subprocess.run(["pgrep", "-x", "quickshell"],
                        stdout=subprocess.DEVNULL)
    if qs.returncode == 0:
        # анимация стартует только когда «зерно» готово: ни одного
        # кадра с пустым кругом. На промахе кэша это ~0.3с паузы.
        seed = make_seed(old, wp) if old else None
        tpath = HOME + "/.config/rice/transition.json"
        tmp = tpath + ".tmp"
        open(tmp, "w").write(json.dumps(
            {"image": wp, "seed": seed or "", "n": os.getpid(),
             "accent": PALETTES[target]["accent"]}))
        os.replace(tmp, tpath)
        return
    sh(f'awww img "{wp}" -t grow --transition-pos center '
       f'--transition-duration 1.4 --transition-fps 60 '
       f'--transition-bezier 0.35,0,0.65,1')

# скрытый режим: предгенерация зерна обратного переключения
# (фоновый вызов без блокировки — пишет только свой кэш-файл)
if len(sys.argv) >= 4 and sys.argv[1] == "--seed":
    sys.exit(0 if make_seed(sys.argv[2], sys.argv[3]) else 1)

# защита от двойного клика: вторая копия просто выходит
_lock = open("/tmp/rice-theme.lock", "w")
try:
    fcntl.flock(_lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
except BlockingIOError:
    sys.exit("already running")

target = sys.argv[1] if len(sys.argv) > 1 else ""
if target not in ("photo", "cappuccino"):
    sys.exit("usage: rice-theme <photo|cappuccino>")

current = "cappuccino"
if os.path.exists(MARKER):
    current = open(MARKER).read().strip() or current
# Даже если тема уже активна — применяем заново (само-восстановление
# обоев и цветов, идемпотентно)

# палитра бара (quickshell анимирует переход через FileView)
PALETTES = {
    # ВНИМАНИЕ: barBg в CSS-формате #RRGGBBAA (альфа ПОСЛЕДНЕЙ парой!)
    # 90 ≈ 56% непрозрачности бара
    "cappuccino": {"barBg": "#11111b90", "onAccent": "#11111b", "surface": "#1e1e2e", "border": "#36364a", "accent": "#89b4fa", "text": "#cdd6f4", "text2": "#a6adc8", "red": "#f38ba8", "dim": "#45475a", "micBg": "#3a252b", "micBorder": "#6b454f", "micText": "#e6a0aa"},
    "photo": {"barBg": "#1a2b1290", "onAccent": "#0f150b", "surface": "#162113", "border": "#31452a", "accent": "#8fc07a", "text": "#edeaf3", "text2": "#acafa8", "red": "#d98f8f", "dim": "#22301d", "micBg": "#25301f", "micBorder": "#4a5a3f", "micText": "#d98f8f"},
}
pal_path = HOME + "/.config/rice/palette.json"

pairs = list(zip(CAP, PHO)) if target == "photo" else list(zip(PHO, CAP))

# обои: капучино — карусель из wallpapers/cappuccino,
# зелёная тема — всегда les1.jpg.
import glob as _glob
WALLDIR = HOME + "/Pictures/wallpapers"
CAPDIR = WALLDIR + "/cappuccino"
CAP_IDX = HOME + "/.config/rice/.cappuccino_idx"
LES_IDX = HOME + "/.config/rice/.wallpaper_idx"
caps = sorted(_glob.glob(CAPDIR + "/*.jpg") + _glob.glob(CAPDIR + "/*.png"))
les = [WALLDIR + "/les1.jpg"]
if not caps:
    caps = [HOME + "/Downloads/Telegram Desktop/photo_2026-08-19_19-41-27.jpg"]
if not les:
    les = [HOME + "/Pictures/wallpapers/les1.jpg"]

def cycle(files, idx_file):
    try:
        i = int(open(idx_file).read().strip())
    except Exception:
        i = -1
    i = (i + 1) % len(files)
    open(idx_file, "w").write(str(i))
    return files[i]

def peek_next(files, idx_file):
    try:
        i = int(open(idx_file).read().strip())
    except Exception:
        i = -1
    return files[(i + 1) % len(files)]

if target == "cappuccino":
    wp = cycle(caps, CAP_IDX)
    next_wp = peek_next(les, LES_IDX)   # следующий тогл — лес
else:
    wp = cycle(les, LES_IDX)
    next_wp = peek_next(caps, CAP_IDX)  # следующий тогл — капучино
last_file = HOME + "/.config/rice/.last_wallpaper"
old_wp = ""
if os.path.exists(last_file):
    old_wp = open(last_file).read().strip()
if wp and os.path.exists(wp):
    show_wallpaper(wp, old_wp if os.path.exists(old_wp) else "")
    open(last_file, "w").write(wp)
    # предгенерация зерна для обратного переключения (в фоне,
    # чтобы следующий тогл взял его из кэша мгновенно)
    if next_wp and os.path.exists(next_wp):
        subprocess.Popen([sys.executable, os.path.abspath(__file__),
                          "--seed", wp, next_wp],
                         stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL,
                         start_new_session=True)

# палитра бара и все остальные цвета — в момент, когда линза начинает
# раскрываться (поп ~0.34с + «зависание» ~0.47с), чтобы бар и рамки
# перекрашивались вместе с кругом обоев, а не раньше него
time.sleep(0.9)
tmp = pal_path + ".tmp"
open(tmp, "w").write(json.dumps(PALETTES[target]))
os.replace(tmp, pal_path)

sub(HOME + "/.config/dunst/dunstrc", pairs)

lua_pairs = [(a.lower(), b.lower()) for a, b in BORDERS]
if target == "cappuccino":
    lua_pairs = [(b, a) for a, b in lua_pairs]
sub(HOME + "/.config/hypr/modules/appearance.lua", lua_pairs)

base_css = HOME + "/.config/walker/themes/winstart/style.css"
photo_dir = HOME + "/.config/walker/themes/winstart-photo"
os.makedirs(photo_dir, exist_ok=True)
css = open(base_css, encoding="utf-8").read()
wmap = WALKER if target == "photo" else [(b, a) for a, b in WALKER]
for a, b in wmap:
    css = css.replace(a.lower(), b.lower())
open(photo_dir + "/style.css", "w", encoding="utf-8").write(css)

conf_path = HOME + "/.config/walker/config.toml"
conf = open(conf_path, encoding="utf-8").read()
theme_name = "winstart-photo" if target == "photo" else "winstart"
conf = re.sub(r'theme\s*=\s*"[^"]*"', f'theme = "{theme_name}"', conf, count=1)
open(conf_path, "w", encoding="utf-8").write(conf)
sh("systemctl --user try-restart walker")

sd = HOME + "/.config/swayosd/style.css"
if os.path.exists(sd):
    smap = SWAYOSD if target == "photo" else [(b, a) for a, b in SWAYOSD]
    sub(sd, smap)
sh("pkill swayosd-server; sleep 0.2; nohup swayosd-server >/dev/null 2>&1 &")

sh("pkill dunst; sleep 0.2; nohup dunst >/dev/null 2>&1 &")
subprocess.run(["hyprctl", "reload"], capture_output=True)
subprocess.run([HOME + "/.local/bin/ff-theme", target], capture_output=True)

os.makedirs(os.path.dirname(MARKER), exist_ok=True)
open(MARKER, "w").write(target)
print("rice theme ->", target)
