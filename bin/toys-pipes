#!/usr/bin/env python3
"""toys-pipes — трубы в truecolor-цветах темы райса (замена pipes.sh).
Бинарный pipes.sh умеет только 8 ANSI-цветов (светлых нет вовсе), поэтому
свой движок: настоящий акцент + настоящий светло-акцент из palette.json.
• Скорость ровно STEP=1/30 — 30 клеток/сек.
• Палитра читается каждый кадр — смена темы перекрашивает трубы мгновенно
  (новые сегменты рисуются уже новым цветом, перезапуск не нужен).
• Выход: q или Ctrl+C."""
import json, os, random, select, shutil, sys, termios, time, tty

RICE = os.environ.get("TOYS_RICE_DIR", os.path.expanduser("~/.config/rice"))
STEP = 1 / 30        # сек между шагами = ровно 30 клеток/сек
RESET_AFTER = 1500   # символов на трубу до очистки экрана

def load_palette():
    try:
        with open(os.path.join(RICE, "palette.json")) as f:
            return json.load(f)
    except Exception:
        return {}

def hx(key, fb):
    h = str(load_palette().get(key, fb)).lstrip("#")
    try:
        return tuple(int(h[i:i + 2], 16) for i in (0, 2, 4))
    except Exception:
        return fb

def blend(a, b, t):
    return tuple(int(round(a[i] + (b[i] - a[i]) * t)) for i in range(3))

def fg(rgb):
    return "\x1b[38;2;%d;%d;%dm" % rgb

def pipe_colors():
    """[акцент, светло-акцент] — из палитры, каждый кадр."""
    acc = hx("accent", (137, 180, 250))
    return [fg(acc), fg(blend(acc, (255, 255, 255), 0.45))]

# глифы: индекс = старое_направление*4 + новое (0 вверх, 1 вправо, 2 вниз, 3 влево)
GLYPHS = "┃┏ ┓┛━┓  ┗┃┛┗ ┏━"

class Pipe:
    __slots__ = ("x", "y", "d", "ci")

    def reset(self, W, H):
        self.d = random.randint(0, 3)
        self.x = random.randint(0, W - 1)
        self.y = random.randint(0, H - 1)

def main():
    signal.signal(signal.SIGTERM, lambda *a: sys.exit(0))
    out = sys.stdout
    out.write("\x1b[?1049h\x1b[?25l\x1b[2J")
    out.flush()
    old_attrs = termios.tcgetattr(0)
    tty.setcbreak(0)
    try:
        W, H = shutil.get_terminal_size((80, 24))
        pipes = []
        for ci in (0, 1):                      # две трубы: акцент и светлая
            p = Pipe()
            p.ci = ci
            p.reset(W, H)
            pipes.append(p)
        drawn = 0
        while True:
            W, H = shutil.get_terminal_size((80, 24))
            colors = pipe_colors()             # палитра — каждый кадр
            buf = []
            for p in pipes:
                old = p.d
                # поворот с вероятностью 30%: ±1 (разворот невозможен)
                if random.random() < 0.30:
                    p.d = (p.d + random.choice((1, 3))) % 4
                if p.d == 0:   p.y -= 1
                elif p.d == 1: p.x += 1
                elif p.d == 2: p.y += 1
                else:          p.x -= 1
                p.x %= W
                p.y %= H
                buf.append("\x1b[%d;%dH%s%s"
                           % (p.y + 1, p.x + 1, colors[p.ci], GLYPHS[old * 4 + p.d]))
                drawn += 1
            out.write("".join(buf))
            out.flush()
            if drawn >= RESET_AFTER:
                drawn = 0
                out.write("\x1b[2J")
                for p in pipes:
                    p.reset(W, H)
            # выход по q
            if select.select((sys.stdin,), (), (), 0)[0]:
                if sys.stdin.read(1) == "q":
                    break
            time.sleep(STEP)
    finally:
        termios.tcsetattr(0, termios.TCSADRAIN, old_attrs)
        out.write("\x1b[0m\x1b[?25h\x1b[?1049l")
        out.flush()

import signal
main()
