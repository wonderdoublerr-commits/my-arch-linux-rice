#!/usr/bin/env python3
"""toys-lavat — мягкие «полупрозрачные» пузыри-метаболлы в цветах темы.
Как в райсах с TikTok: пузырь — гладкая ЗАЛИВКА фона ячеек, но цвет
заранее приглушён смешиванием с тёмным тоном темы (FADE<1), поэтому
выглядит как полупрозрачный, а не как кислотное пятно.
Палитра читается каждый кадр — смена темы видна сразу. Выход: q."""
import json, math, os, random, select, shutil, sys, termios, time, tty

RICE = os.environ.get("TOYS_RICE_DIR", os.path.expanduser("~/.config/rice"))
VEL = 0.9            # клеток за тик — бодро
TICK = 0.06          # сек между кадрами
NBALLS = 5           # количество пузырей
RADIUS = 5.0         # радиус метаболла — компактные пузыри, не на весь экран
T0 = 1.5             # порог появления пузыря (выше = меньше пузырь)
FADE = 0.40          # яркость пузыря: доля акцента в цвете (остальное — фон темы)
                     # cappuccino -> сине-серый #4d6080, photo -> приглушённо-зелёный

def load_palette():
    try:
        with open(os.path.join(RICE, "palette.json")) as f:
            return json.load(f)
    except Exception:
        return {}

def hx(key, fb):
    h = str(load_palette().get(key, fb)).lstrip("#")
    try:
        return tuple(int(h[i:i + 2], 16) for i in (0, 2, 4))
    except Exception:
        return fb

def blend(a, b, t):
    return tuple(int(round(a[i] + (b[i] - a[i]) * t)) for i in range(3))

def fg(rgb):
    return "\x1b[38;2;%d;%d;%dm" % rgb

def lava_color():
    """Единый цвет заливки пузыря: FADE*акцент + (1-FADE)*фон темы.
    Читается каждый кадр — при смене темы пузырь перекрашивается сам."""
    acc = hx("accent", (137, 180, 250))
    surf = hx("surface", (30, 30, 46))
    return "\x1b[48;2;%d;%d;%dm" % blend(surf, acc, FADE)

def main():
    signal.signal(signal.SIGTERM, lambda *a: sys.exit(0))
    out = sys.stdout
    out.write("\x1b[?1049h\x1b[?25l\x1b[2J")
    out.flush()
    old_attrs = termios.tcgetattr(0)
    tty.setcbreak(0)
    try:
        W, H = shutil.get_terminal_size((80, 24))
        last_size = None
        balls = []
        while len(balls) < NBALLS:
            balls.append([random.uniform(0, W), random.uniform(0, H),
                          random.uniform(-VEL, VEL), random.uniform(-VEL, VEL)])
        while True:
            W, H = shutil.get_terminal_size((80, 24))
            if (W, H) != last_size:
                last_size = (W, H)
                out.write("\x1b[2J")
            colors = None  # цвет один и фиксированный
            lava = lava_color()
            # движение и отскок от краёв
            for b in balls:
                b[0] += b[2]
                b[1] += b[3]
                if b[0] < 0:            b[0] = 0.0;            b[2] = abs(b[2])
                if b[0] > W - 1:        b[0] = float(W - 1);   b[2] = -abs(b[2])
                if b[1] < 0:            b[1] = 0.0;            b[3] = abs(b[3])
                if b[1] > H - 1:        b[1] = float(H - 1);   b[3] = -abs(b[3])
            # поле метаболлов -> ГЛАДКАЯ заливка фона ячеек ОДНИМ цветом
            r2 = RADIUS * RADIUS
            default = "\x1b[49m "
            buf = ["\x1b[H"]
            for cy in range(H):
                buf.append("\x1b[%d;1H" % (cy + 1))
                for cx in range(W):
                    v = 0.0
                    for b in balls:
                        dx = (cx - b[0]) * 0.5
                        dy = cy - b[1]
                        v += r2 / (dx * dx + dy * dy + 1.0)
                    if v <= T0:
                        buf.append(default)
                    else:
                        buf.append(lava + " ")
            out.write("".join(buf))
            out.flush()
            if select.select((sys.stdin,), (), (), 0)[0]:
                if sys.stdin.read(1) == "q":
                    break
            time.sleep(TICK)
    finally:
        termios.tcsetattr(0, termios.TCSADRAIN, old_attrs)
        out.write("\x1b[0m\x1b[?25h\x1b[?1049l")
        out.flush()

import signal
main()
