#!/usr/bin/env python3
"""toys-matrix — «матрица» в цветах темы райса БЕЗ чёрного фона.
Оригинальный cmatrix заливает фон кодами [40m (чёрный) — поэтому поверх
обоев выглядит чёрным квадратом. Здесь используются ТОЛЬКО цвета символов
(truecolor из palette.json): фон терминала не трогается, прозрачность и
обои остаются видимыми, как в райсах с TikTok."""
import json, os, random, shutil, sys, time

RICE = os.environ.get("TOYS_RICE_DIR", os.path.expanduser("~/.config/rice"))

def load_palette():
    try:
        with open(os.path.join(RICE, "palette.json")) as f:
            return json.load(f)
    except Exception:
        return {}

def hx(key, fb):
    h = str(load_palette().get(key, fb)).lstrip("#")
    try:
        return tuple(int(h[i:i + 2], 16) for i in (0, 2, 4))
    except Exception:
        return fb

def blend(a, b, t):
    return tuple(int(round(a[i] + (b[i] - a[i]) * t)) for i in range(3))

def fg(rgb):
    return "\x1b[38;2;%d;%d;%dm" % rgb

# Читаемые символы (полуширокая катакана убрана — в некоторых шрифтах
# превращается в квадратики). Вернуть её можно: TOYS_MATRIX_KATA=1 cmatrix
CHARS = list("0123456789ABCDEFGHKLMNPQRSTUVWXYZ" + "*+-<>|=:.")
if os.environ.get("TOYS_MATRIX_KATA"):
    CHARS += [chr(c) for c in range(0xFF66, 0xFF9E)]  # полуширокая катакана

class Column:
    __slots__ = ("y", "ln", "spd", "cnt", "colors")

    def reset(self, H):
        self.ln = random.randint(4, max(6, H // 3))
        self.spd = random.randint(2, 4)   # медленнее: шаг раз в 2-4 тика
        self.cnt = random.randint(0, self.spd - 1)
        self.y = random.randint(0, max(1, H))
        acc = hx("accent", (137, 180, 250))
        surf = hx("surface", (30, 30, 46))
        head = blend(acc, (255, 255, 255), 0.45)   # яркая «голова»
        tail = blend(acc, surf, 0.55)              # затухающий хвост
        self.colors = [fg(blend(head, tail, i / max(1, self.ln - 1)))
                       for i in range(self.ln)]

def main():
    signal.signal(signal.SIGTERM, lambda *a: sys.exit(0))
    out = sys.stdout
    out.write("\x1b[?1049h\x1b[?25l\x1b[2J")
    out.flush()
    W, H = shutil.get_terminal_size((80, 24))
    cols = []

    def ensure(n):
        while len(cols) < n:
            c = Column()
            c.reset(H)
            c.y = random.randint(-H, H)
            cols.append(c)
        del cols[n:]

    ensure(W)
    try:
        while True:
            W, H = shutil.get_terminal_size((80, 24))
            ensure(W)
            buf = []
            for x, c in enumerate(cols, 1):
                c.cnt += 1
                if c.cnt >= c.spd:
                    c.cnt = 0
                    c.y += 1
                    if c.y - c.ln > H:
                        c.reset(H)
                for i in range(c.ln):
                    yy = c.y - i
                    if 1 <= yy <= H:
                        buf.append("\x1b[%d;%dH%s%s"
                                   % (yy, x, c.colors[i], random.choice(CHARS)))
                yy = c.y - c.ln
                if 1 <= yy <= H:                    # стереть клетку за хвостом
                    buf.append("\x1b[%d;%dH " % (yy, x))
            out.write("\x1b[0m" + "".join(buf))
            out.flush()
            time.sleep(0.085)   # медленнее
    finally:
        out.write("\x1b[0m\x1b[?25h\x1b[?1049l")
        out.flush()

import signal
main()
